# ---- Server ----
PORT=5000
NODE_ENV=development

# Comma-separated list of origins allowed to call this API (your deployed frontend URL(s)).
# For local dev, the Vite dev server default is included.
CORS_ORIGIN=http://localhost:5173

# ---- MongoDB ----
# A MongoDB Atlas (or self-hosted) connection string. Create a free cluster at
# https://www.mongodb.com/cloud/atlas if you don't have one.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nilaksh-portfolio?retryWrites=true&w=majority

# ---- Auth ----
# Long, random secret used to sign admin session JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# How long an admin session stays valid.
JWT_EXPIRES_IN=7d
# Set to "true" only when serving the API over HTTPS in production (makes the
# admin session cookie Secure + SameSite=None capable).
COOKIE_SECURE=false

# One-time admin bootstrap: used only by `npm run create-admin`, never read at
# runtime by the server, and only works while no administrator account exists.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password

# ---- Image uploads (Cloudinary) ----
# Create a free account at https://cloudinary.com and copy these from your
# dashboard. Without them, image upload endpoints return a clear 503 error
# instead of silently failing.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Optional: contact form email delivery ----
# If you enable the contact form in /admin/contact, configure an SMTP-based
# transactional email provider here (e.g. Resend, Postmark, SendGrid SMTP).
# Leave blank to keep the contact form disabled; the API will refuse to
# "succeed" a submission it cannot actually deliver.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
CONTACT_RECEIVING_EMAIL=
